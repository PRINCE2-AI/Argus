# Copy to .env and fill in one provider key. Never commit .env.

# Google Gemini (default when no provider is configured)
GEMINI_API_KEY=

# Other cloud providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Optional fallback key used by cloud providers when their specific key is unset
# ARGUS_API_KEY=

# Optional model and endpoint overrides
# ARGUS_PROVIDER=gemini
# ARGUS_MODEL=gemini-3.1-flash-lite
# ARGUS_BASE_URL=
# ARGUS_LANG=en

# Optional Jev semantic safety layer
# JEV_API_KEY=
# JEV_MODEL=jev-latest
# JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
